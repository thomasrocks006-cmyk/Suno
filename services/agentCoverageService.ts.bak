/**
 * AGENT COVERAGE ANALYSIS SERVICE
 * Evaluates what percentage of the song was reviewed by each agent
 * Identifies gaps where no agent provided feedback
 */

import { RewritePlanProposal } from '../types';

export interface AgentCoverageReport {
  totalLines: number;
  linesAnalyzed: number;
  coveragePercentage: number;
  agentParticipation: {
    songwriter: {
      linesReviewed: number;
      percentage: number;
      strongOpinions: number; // Positions with high confidence
    };
    producer: {
      linesReviewed: number;
      percentage: number;
      strongOpinions: number;
    };
  };
  uncoveredLines: Array<{
    lineNumber: number;
    originalLine: string;
    proposedLine: string;
    reason: string; // Why no agent reviewed this
  }>;
  debateHotspots: Array<{
    lineNumber: number;
    originalLine: string;
    disagreementLevel: 'mild' | 'moderate' | 'severe';
    finalDecision: string;
  }>;
  recommendations: string[];
}

/**
 * Calculate how much of the plan was actually reviewed by agents
 */
export const analyzeAgentCoverage = (
  plan: RewritePlanProposal
): AgentCoverageReport => {
  
  const totalLines = plan.executionPlan.lineLevelChanges.length;
  const debates = plan.agentDebates || [];
  
  // Build lookup map for quick access
  const debatesByLine = new Map<number, AgentDebateResult>();
  debates.forEach(debate => {
    debatesByLine.set(debate.lineNumber, debate);
  });

  const linesAnalyzed = debates.length;
  const coveragePercentage = totalLines > 0 
    ? Math.round((linesAnalyzed / totalLines) * 100)
    : 0;

  // Count agent participation
  let songwriterReviewed = 0;
  let songwriterStrong = 0;
  let producerReviewed = 0;
  let producerStrong = 0;

  debates.forEach(debate => {
    if (debate.songwriterPosition && debate.songwriterPosition !== 'no opinion') {
      songwriterReviewed++;
      if (
        debate.songwriterPosition.toLowerCase().includes('strongly') ||
        debate.songwriterPosition.toLowerCase().includes('critical')
      ) {
        songwriterStrong++;
      }
    }

    if (debate.producerPosition && debate.producerPosition !== 'no opinion') {
      producerReviewed++;
      if (
        debate.producerPosition.toLowerCase().includes('strongly') ||
        debate.producerPosition.toLowerCase().includes('critical')
      ) {
        producerStrong++;
      }
    }
  });

  // Find uncovered lines
  const uncoveredLines = plan.lineChanges
    .filter(change => !debatesByLine.has(change.lineNumber))
    .map(change => ({
      lineNumber: change.lineNumber,
      originalLine: change.originalLine,
      proposedLine: change.newLine,
      reason: determineWhyNotCovered(change.originalLine, change.proposedLine)
    }));

  // Find debate hotspots (disagreements)
  const debateHotspots = debates
    .filter(debate => {
      const writerPos = debate.songwriterPosition.toLowerCase();
      const producerPos = debate.producerPosition.toLowerCase();
      
      // Check for disagreement keywords
      const writerLikes = writerPos.includes('approve') || writerPos.includes('good') || writerPos.includes('strong');
      const writerDislikes = writerPos.includes('reject') || writerPos.includes('weak') || writerPos.includes('concern');
      const producerLikes = producerPos.includes('approve') || producerPos.includes('good') || producerPos.includes('strong');
      const producerDislikes = producerPos.includes('reject') || producerPos.includes('weak') || producerPos.includes('concern');

      return (writerLikes && producerDislikes) || (writerDislikes && producerLikes);
    })
    .map(debate => ({
      lineNumber: debate.lineNumber,
      originalLine: debate.originalLine,
      disagreementLevel: calculateDisagreementLevel(debate),
      finalDecision: debate.finalDecision
    }));

  // Generate recommendations
  const recommendations = generateCoverageRecommendations(
    coveragePercentage,
    uncoveredLines,
    debateHotspots,
    { songwriterReviewed, producerReviewed, totalLines }
  );

  return {
    totalLines,
    linesAnalyzed,
    coveragePercentage,
    agentParticipation: {
      songwriter: {
        linesReviewed: songwriterReviewed,
        percentage: totalLines > 0 ? Math.round((songwriterReviewed / totalLines) * 100) : 0,
        strongOpinions: songwriterStrong
      },
      producer: {
        linesReviewed: producerReviewed,
        percentage: totalLines > 0 ? Math.round((producerReviewed / totalLines) * 100) : 0,
        strongOpinions: producerStrong
      }
    },
    uncoveredLines,
    debateHotspots,
    recommendations
  };
};

/**
 * Determine why a line wasn't covered by agents
 */
const determineWhyNotCovered = (originalLine: string, proposedLine: string): string => {
  
  // Check if it's a minor punctuation change
  const origNoPunc = originalLine.replace(/[.,!?;:'"]/g, '').toLowerCase();
  const propNoPunc = proposedLine.replace(/[.,!?;:'"]/g, '').toLowerCase();
  
  if (origNoPunc === propNoPunc) {
    return 'Punctuation-only change (low priority for debate)';
  }

  // Check if it's a single word swap
  const origWords = originalLine.split(/\s+/);
  const propWords = proposedLine.split(/\s+/);
  
  if (origWords.length === propWords.length) {
    const differences = origWords.filter((word, i) => word !== propWords[i]);
    if (differences.length === 1) {
      return 'Single word substitution (automated improvement)';
    }
  }

  // Check if it's structural metadata (e.g., "[Verse 1]")
  if (originalLine.trim().startsWith('[') || proposedLine.trim().startsWith('[')) {
    return 'Structural metadata (non-lyrical content)';
  }

  return 'Unknown (may need agent review)';
};

/**
 * Calculate severity of disagreement between agents
 */
const calculateDisagreementLevel = (debate: AgentDebateResult): 'mild' | 'moderate' | 'severe' => {
  
  const writerPos = debate.songwriterPosition.toLowerCase();
  const producerPos = debate.producerPosition.toLowerCase();

  // Severe: One strongly approves, other strongly rejects
  if (
    (writerPos.includes('strongly approve') && producerPos.includes('reject')) ||
    (producerPos.includes('strongly approve') && writerPos.includes('reject'))
  ) {
    return 'severe';
  }

  // Moderate: Mixed signals
  if (
    (writerPos.includes('approve') && producerPos.includes('concern')) ||
    (producerPos.includes('approve') && writerPos.includes('concern'))
  ) {
    return 'moderate';
  }

  return 'mild';
};

/**
 * Generate actionable recommendations based on coverage analysis
 */
const generateCoverageRecommendations = (
  coveragePercentage: number,
  uncoveredLines: any[],
  debateHotspots: any[],
  participation: { songwriterReviewed: number; producerReviewed: number; totalLines: number }
): string[] => {
  
  const recommendations: string[] = [];

  // Coverage recommendations
  if (coveragePercentage < 30) {
    recommendations.push(`❌ CRITICAL: Only ${coveragePercentage}% of lines were reviewed by agents. Consider running full debate mode.`);
  } else if (coveragePercentage < 60) {
    recommendations.push(`⚠️ WARNING: ${coveragePercentage}% coverage is below ideal (aim for 80%+). Review uncovered lines.`);
  } else if (coveragePercentage >= 90) {
    recommendations.push(`✅ EXCELLENT: ${coveragePercentage}% agent coverage - comprehensive review achieved.`);
  }

  // Agent balance recommendations
  const writerCoverage = participation.songwriterReviewed;
  const producerCoverage = participation.producerReviewed;
  const imbalance = Math.abs(writerCoverage - producerCoverage);

  if (imbalance > participation.totalLines * 0.3) {
    recommendations.push(`⚖️ IMBALANCE: Songwriter reviewed ${writerCoverage} lines, Producer ${producerCoverage}. One agent is underrepresented.`);
  }

  // Hotspot recommendations
  if (debateHotspots.length > 0) {
    recommendations.push(`🔥 ${debateHotspots.length} debate hotspot(s) found. Review these carefully as agents disagreed.`);
  }

  // Uncovered lines recommendations
  if (uncoveredLines.length > 5) {
    const unknownReasons = uncoveredLines.filter(u => u.reason.includes('Unknown'));
    if (unknownReasons.length > 0) {
      recommendations.push(`🔍 ${unknownReasons.length} line(s) skipped for unknown reasons. Consider manual review.`);
    }
  }

  return recommendations;
};
