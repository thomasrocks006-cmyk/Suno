            <div className="bg-black/30 rounded p-3 border border-cyan-500/20">
              <div className="text-xs font-bold text-cyan-400 mb-2">
                Debates {coverageReport.debateHotspots.length > 0 && `(${coverageReport.debateHotspots.length})`}
