                                      className={`w-3 h-3 text-gray-400 transition-transform ${expandedScoreItem === i ? 'rotate-180' : ''}`} 
                                      fill="none" 
                                      stroke="currentColor" 
                                      viewBox="0 0 24 24"
                                  >
